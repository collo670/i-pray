+/* ---------------------------------------------------------------------------
+   Bibilia Takatifu card + sheet accordion
+   Uses the same light/dark accent palette as Masifu ya Asubuhi
+   (css/masifu.css): light accent #8B0000, dark accent #FFA07A.
+   --------------------------------------------------------------------------- */
+.biblia-card-icon {
+    color: #fff;
+    background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
+}
+
+:root.dark .biblia-card-icon {
+    color: #1a1010;
+    background: linear-gradient(135deg, #FFA07A 0%, #FFB385 100%);
+}
+
+.testament-group {
+    border: 1px solid rgba(139, 0, 0, 0.15);
+    border-radius: 14px;
+    overflow: hidden;
+    background: var(--surface-0);
+}
+
+:root.dark .testament-group {
+    border-color: rgba(255, 160, 122, 0.22);
+}
+
+.testament-toggle {
+    width: 100%;
+    display: flex;
+    align-items: center;
+    gap: 0.6rem;
+    background: rgba(139, 0, 0, 0.06);
+    border: none;
+    cursor: pointer;
+    font-family: inherit;
+    padding: 0.9rem 1rem;
+    text-align: left;
+}
+
+:root.dark .testament-toggle {
+    background: rgba(255, 160, 122, 0.09);
+}
+
+.testament-toggle-label {
+    flex: 1;
+    font-weight: 700;
+    font-size: 1.02em;
+    color: #8B0000;
+}
+
+:root.dark .testament-toggle-label {
+    color: #FFA07A;
+}
+
+.testament-toggle-count {
+    font-size: 0.78em;
+    font-weight: 500;
+    color: var(--text-primary);
+    opacity: 0.6;
+}
+
+.testament-chevron {
+    color: #8B0000;
+    flex-shrink: 0;
+    transition: transform 0.2s ease;
+}
+
+:root.dark .testament-chevron {
+    color: #FFA07A;
+}
+
+.testament-toggle-open .testament-chevron {
+    transform: rotate(180deg);
+}
+
+.testament-book-list {
+    list-style: none;
+    margin: 0;
+    padding: 0.4rem 0.5rem 0.6rem;
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 0.15rem 0.5rem;
+}
+
+@media (max-width: 380px) {
+    .testament-book-list {
+        grid-template-columns: 1fr;
+    }
+}
+
+.testament-book-item {
+    width: 100%;
+    display: block;
+    background: none;
+    border: none;
+    cursor: pointer;
+    font-family: inherit;
+    text-align: left;
+    padding: 0.5rem 0.6rem;
+    border-radius: 8px;
+    font-size: 0.92em;
+    color: var(--text-primary);
+    transition: background-color 0.15s ease, color 0.15s ease;
+}
+
+.testament-book-item:hover,
+.testament-book-item:focus-visible {
+    background: rgba(139, 0, 0, 0.08);
+    color: #8B0000;
+    outline: none;
+}
+
+:root.dark .testament-book-item:hover,
+:root.dark .testament-book-item:focus-visible {
+    background: rgba(255, 160, 122, 0.1);
+    color: #FFA07A;
+}
+
+.testament-book-item-active {
+    background: rgba(139, 0, 0, 0.1);
+    color: #8B0000;
+    font-weight: 600;
+}
+
+:root.dark .testament-book-item-active {
+    background: rgba(255, 160, 122, 0.14);
+    color: #FFA07A;
+}
