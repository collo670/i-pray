+    <!-- Bibilia Takatifu sheet toggle + Agano la Kale / Agano Jipya accordion -->
+    <script>
+        (function () {
+            var sheet = document.getElementById('bibliaTakatifuSheet');
+            var openBtn = document.getElementById('bibliaTakatifuCard');
+            var closeBtn = document.getElementById('closeBibliaTakatifuSheet');
+            if (!sheet) return;
+
+            function openSheet() {
+                sheet.classList.remove('hidden');
+                requestAnimationFrame(function () { sheet.classList.add('open'); });
+                document.body.classList.add('overflow-hidden');
+            }
+
+            function closeSheet() {
+                sheet.classList.remove('open');
+                document.body.classList.remove('overflow-hidden');
+                setTimeout(function () { sheet.classList.add('hidden'); }, 250);
+            }
+
+            if (openBtn) openBtn.addEventListener('click', openSheet);
+            if (closeBtn) closeBtn.addEventListener('click', closeSheet);
+            sheet.addEventListener('click', function (e) {
+                if (e.target === sheet) closeSheet();
+            });
+            document.addEventListener('keydown', function (e) {
+                if (e.key === 'Escape' && !sheet.classList.contains('hidden')) closeSheet();
+            });
+
+            // Agano la Kale / Agano Jipya accordion: clicking a testament reveals its
+            // list of books; clicking it again (or the other testament) hides it.
+            var testaments = [
+                { toggle: 'aganoLaKaleToggle', list: 'aganoLaKaleList' },
+                { toggle: 'aganoJipyaToggle', list: 'aganoJipyaList' }
+            ];
+
+            testaments.forEach(function (t) {
+                var toggleBtn = document.getElementById(t.toggle);
+                var list = document.getElementById(t.list);
+                if (!toggleBtn || !list) return;
+
+                toggleBtn.addEventListener('click', function () {
+                    var isOpen = !list.classList.contains('hidden');
+                    if (isOpen) {
+                        list.classList.add('hidden');
+                        toggleBtn.setAttribute('aria-expanded', 'false');
+                        toggleBtn.classList.remove('testament-toggle-open');
+                    } else {
+                        list.classList.remove('hidden');
+                        toggleBtn.setAttribute('aria-expanded', 'true');
+                        toggleBtn.classList.add('testament-toggle-open');
+                    }
+                });
+            });
+
+            // Each book item is a placeholder tap target for now; wiring it up to a
+            // reader page is a follow-up (see data-book on each <button>).
+            sheet.querySelectorAll('.testament-book-item').forEach(function (item) {
+                item.addEventListener('click', function () {
+                    sheet.querySelectorAll('.testament-book-item').forEach(function (el) {
+                        el.classList.remove('testament-book-item-active');
+                    });
+                    item.classList.add('testament-book-item-active');
+                });
+            });
+        })();
+    </script>
     <script src="js/prevent-zoom.js" defer></script>
