+            // Parses the Markdown that r.jina.ai's Reader returns for an
+            // mkatolikileo.com article. The Reader ignores the site's HTML
+            // classes/layout entirely, so this only depends on the visible
+            // content shape, which has been stable: a "### Day Title
+            // (Date)" heading, then repeating [plain label line] / [###
+            // citation] / [body text] triples ("Somo la 1", "Wimbo wa
+            // Katikati" / "Zaburi ya Katikati", "Shangilio", "Injili", plus
+            // "Somo la 2" on Sundays and solemnities).
+            function parseSwArticleText(md) {
+                if (!md) return null;
+                var lines = md.replace(/\r\n/g, '\n').split('\n');
+                var dayTitle = '', dateLabel = '', startIdx = -1;
+                for (var i = 0; i < lines.length; i++) {
+                    var head = lines[i].match(/^#{2,3}\s+(.+?)\s*\(([^()]+)\)\s*$/);
+                    if (head) { dayTitle = head[1].trim(); dateLabel = head[2].trim(); startIdx = i + 1; break; }
+                }
+                if (startIdx === -1) return null;
+
+                function isStop(line) {
+                    return /^\d+\s*Imependwa/.test(line) || /^#{1,3}\s*Maoni\b/.test(line);
+                }
+
+                var sections = [];
+                var i2 = startIdx;
+                while (i2 < lines.length) {
+                    var line = lines[i2].trim();
+                    i2++;
+                    if (!line || isStop(line) || line.charAt(0) === '#') continue;
+
+                    var j = i2;
+                    while (j < lines.length && !lines[j].trim()) j++;
+                    var citeMatch = j < lines.length ? lines[j].match(/^###\s+(.+)$/) : null;
+                    if (!citeMatch) continue;
+
+                    var label = line.replace(/\*\*/g, '').trim();
+                    var citation = citeMatch[1].trim();
+                    i2 = j + 1;
+
+                    var bodyLines = [];
+                    while (i2 < lines.length) {
+                        var peekTrim = lines[i2].trim();
+                        if (isStop(peekTrim)) break;
+                        if (peekTrim && lines[i2].charAt(0) !== '#') {
+                            var k = i2 + 1;
+                            while (k < lines.length && !lines[k].trim()) k++;
+                            if (k < lines.length && /^###\s+/.test(lines[k])) break;
+                        } else if (peekTrim.charAt(0) === '#') {
+                            break;
+                        }
+                        bodyLines.push(lines[i2]);
+                        i2++;
+                    }
+                    var text = bodyLines.join('\n').trim();
+                    if (!text) continue;
+                    sections.push({ label: label, citation: citation, textHtml: swTextToHtml(text) });
+                }
+                if (!sections.length) return null;
+                return { dayTitle: dayTitle, dateLabel: dateLabel, sections: sections };
+            }
+
+            function swTextToHtml(text) {
+                var esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+                return esc.split(/\n{2,}/).map(function (p) {
+                    return '<div>' + p.trim().replace(/ {2,}\n|\n/g, '<br>') + '</div>';
+                }).join('');
+            }
+
